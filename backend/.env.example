# Fungsi file: Contoh variabel lingkungan lokal; salin dan sesuaikan kredensial sebelum digunakan.

# Export these values into the shell; Django does not auto-load this file.
DJANGO_SECRET_KEY=replace-with-a-random-secret-before-use
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=simevent
POSTGRES_USER=simevent
POSTGRES_PASSWORD=replace-with-your-local-database-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
